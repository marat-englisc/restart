// Модуль основной формы внешней обработки ПрактикумУправляемыхФорм.
// В редакторе формы ПриСозданииНаСервере назначено соответствующему событию.
// Данные существуют только в форме. Записи в информационную базу нет.

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    ТипЧисла = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2));
    Реквизиты = Новый Массив;
    Реквизиты.Добавить(Новый РеквизитФормы("Строки", Новый ОписаниеТипов("ТаблицаЗначений")));
    Реквизиты.Добавить(Новый РеквизитФормы("Наименование", Новый ОписаниеТипов("Строка"), "Строки"));
    Реквизиты.Добавить(Новый РеквизитФормы("Количество", ТипЧисла, "Строки"));
    Реквизиты.Добавить(Новый РеквизитФормы("Цена", ТипЧисла, "Строки"));
    Реквизиты.Добавить(Новый РеквизитФормы("Сумма", ТипЧисла, "Строки"));
    Реквизиты.Добавить(Новый РеквизитФормы("ИтогТоваров", ТипЧисла));
    ИзменитьРеквизиты(Реквизиты);

    Таблица = Элементы.Добавить("Строки", Тип("ТаблицаФормы"));
    Таблица.ПутьКДанным = "Строки";
    Таблица.Заголовок = "Учебные товары (данные только в форме)";
    Таблица.УстановитьДействие("ПослеУдаления", "СтрокиПослеУдаления");

    Для Каждого ИмяКолонки Из СтрРазделить("Наименование,Количество,Цена,Сумма", ",") Цикл
        Поле = Элементы.Добавить("Строки" + ИмяКолонки, Тип("ПолеФормы"), Таблица);
        Поле.Вид = ВидПоляФормы.ПолеВвода;
        Поле.ПутьКДанным = "Строки." + ИмяКолонки;
        Поле.Заголовок = ИмяКолонки;
        Если ИмяКолонки = "Количество" Или ИмяКолонки = "Цена" Тогда
            Поле.УстановитьДействие("ПриИзменении", "КоличествоИлиЦенаПриИзменении");
        КонецЕсли;
        Если ИмяКолонки = "Сумма" Тогда
            Поле.ТолькоПросмотр = Истина;
        КонецЕсли;
    КонецЦикла;

    ПолеИтога = Элементы.Добавить("ИтогТоваров", Тип("ПолеФормы"));
    ПолеИтога.Вид = ВидПоляФормы.ПолеВвода;
    ПолеИтога.ПутьКДанным = "ИтогТоваров";
    ПолеИтога.Заголовок = "Итог товаров";
    ПолеИтога.ТолькоПросмотр = Истина;

    Команда = Команды.Добавить("ПересчитатьВсе");
    Команда.Заголовок = "Пересчитать все строки";
    Команда.Действие = "ПересчитатьВсе";
    Кнопка = Элементы.Добавить("ПересчитатьВсе", Тип("КнопкаФормы"));
    Кнопка.ИмяКоманды = "ПересчитатьВсе";

    Строка = ЭтотОбъект.Строки.Добавить();
    Строка.Наименование = "Учебный товар А";
    Строка.Количество = 2;
    Строка.Цена = 150;
    Строка.Сумма = 300;
    Строка = ЭтотОбъект.Строки.Добавить();
    Строка.Наименование = "Учебный товар Б";
    Строка.Количество = 3;
    Строка.Цена = 100;
    Строка.Сумма = 300;
    ЭтотОбъект.ИтогТоваров = ЭтотОбъект.Строки.Итог("Сумма");
КонецПроцедуры

&НаКлиенте
Процедура КоличествоИлиЦенаПриИзменении(Элемент)
    ТекущаяСтрока = Элементы.Строки.ТекущиеДанные;
    Если ТекущаяСтрока = Неопределено Тогда
        Возврат;
    КонецЕсли;
    ТекущаяСтрока.Сумма = Окр(ТекущаяСтрока.Количество * ТекущаяСтрока.Цена, 2);
    ЭтотОбъект.ИтогТоваров = ЭтотОбъект.Строки.Итог("Сумма");
КонецПроцедуры

&НаКлиенте
Процедура СтрокиПослеУдаления(Элемент)
    ЭтотОбъект.ИтогТоваров = ЭтотОбъект.Строки.Итог("Сумма");
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьВсе(Команда)
    Для Каждого Строка Из ЭтотОбъект.Строки Цикл
        Строка.Сумма = Окр(Строка.Количество * Строка.Цена, 2);
    КонецЦикла;
    ЭтотОбъект.ИтогТоваров = ЭтотОбъект.Строки.Итог("Сумма");
КонецПроцедуры

